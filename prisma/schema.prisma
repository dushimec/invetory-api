generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum TrackingMode {
  NONE
  BATCH
  SERIAL
  EXPIRY
  BATCH_EXPIRY
}

enum MovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALE_ISSUE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  STOCK_COUNT
  RESERVATION
  RESERVATION_RELEASE
  REVERSAL
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  REJECTED
  CLOSED
}

enum ProcurementType {
  LOCAL
  IMPORT
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
  REVERSED
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

enum SalesStatus {
  DRAFT
  CONFIRMED
  RESERVED
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum SalesPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum SerialStatus {
  AVAILABLE
  RESERVED
  IN_TRANSIT
  ISSUED
  SUPPLIER_RETURNED
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum StockStatus {
  AVAILABLE
  QUARANTINED
  EXPIRED
  RECALLED
  DAMAGED
}

enum ReturnType {
  CUSTOMER
  SUPPLIER
}

model Organization {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String
  slug            String                   @unique
  memberships     OrganizationMembership[]
  sessions        UserSession[]
  settings        OrganizationSettings?
  roles           Role[]
  warehouses      Warehouse[]
  categories      ProductCategory[]
  units           UnitOfMeasure[]
  products        Product[]
  suppliers       Supplier[]
  customers       Customer[]
  balances        InventoryBalance[]
  movements       InventoryMovement[]
  serialNumbers   StockSerial[]
  batches         StockBatch[]
  purchases       PurchaseOrder[]
  receipts        GoodsReceipt[]
  sales           SalesOrder[]
  reservations    InventoryReservation[]
  transfers       StockTransfer[]
  adjustments     StockAdjustment[]
  stockCounts     StockCount[]
  returns         InventoryReturn[]
  idempotency     IdempotencyRecord[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  salesDeliveries SalesDelivery[]
  salesPayments   SalesPayment[]
}

model OrganizationSettings {
  id                        String       @id @default(uuid()) @db.Uuid
  organizationId            String       @unique @db.Uuid
  businessName              String
  address                   String?
  logoUrl                   String?
  taxSettings               Json         @default("{}")
  salesTaxRate              Decimal      @default(0) @db.Decimal(7, 4)
  maxSalesDiscountPercent   Decimal      @default(0) @db.Decimal(7, 4)
  baseCurrency              String       @default("RWF") @db.Char(3)
  timezone                  String       @default("Africa/Kigali")
  allowNegativeStock        Boolean      @default(false)
  requirePurchaseApproval   Boolean      @default(true)
  requireSeparationOfDuties Boolean      @default(true)
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedAt                 DateTime     @updatedAt
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique
  fullName           String
  passwordHash       String
  isActive           Boolean                  @default(true)
  mustChangePassword Boolean                  @default(false)
  failedLoginCount   Int                      @default(0)
  lockedUntil        DateTime?
  memberships        OrganizationMembership[]
  sessions           UserSession[]
  resetTokens        PasswordResetToken[]
  salesPaymentsReceived SalesPayment[]
  auditLogs          AuditLog[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Role {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String?                  @db.Uuid
  name           String
  description    String                   @default("")
  duties         String[]                 @default([])
  isSystem       Boolean                  @default(false)
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    OrganizationMembership[]
  createdAt      DateTime                 @default(now())

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserSession {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.Uuid
  organizationId      String       @db.Uuid
  refreshTokenHash    String       @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?      @db.Uuid
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Warehouse {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  code           String
  address        String?
  isActive       Boolean             @default(true)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations      WarehouseLocation[]
  balances       InventoryBalance[]
  movements      InventoryMovement[]
  purchases      PurchaseOrder[]
  receipts       GoodsReceipt[]
  sales          SalesOrder[]
  deliveries     SalesDelivery[]
  serialNumbers  StockSerial[]
  transfersFrom  StockTransfer[]     @relation("TransferSource")
  transfersTo    StockTransfer[]     @relation("TransferDestination")
  adjustments    StockAdjustment[]
  stockCounts    StockCount[]
  returns        InventoryReturn[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model WarehouseLocation {
  id            String                 @id @default(uuid()) @db.Uuid
  warehouseId   String                 @db.Uuid
  code          String
  name          String
  isActive      Boolean                @default(true)
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  balances      InventoryBalance[]
  movements     InventoryMovement[]
  reservations  InventoryReservation[]
  serialNumbers StockSerial[]
  returnItems   InventoryReturnItem[]
  stockCountItems StockCountItem[]
  createdAt     DateTime               @default(now())

  @@unique([warehouseId, code])
  @@index([warehouseId, isActive])
}

model ProductCategory {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  parentId       String?           @db.Uuid
  name           String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProductCategory[] @relation("CategoryTree")
  products       Product[]
  createdAt      DateTime          @default(now())

  @@unique([organizationId, parentId, name])
  @@index([organizationId, parentId])
}

model UnitOfMeasure {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  symbol         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, symbol])
}

model Product {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  categoryId      String?                @db.Uuid
  unitId          String                 @db.Uuid
  sku             String
  barcode         String?
  name            String
  description     String?
  brand           String?
  purchaseCost    Decimal                @default(0) @db.Decimal(20, 4)
  sellingPrice    Decimal                @default(0) @db.Decimal(20, 4)
  wholesalePrice  Decimal?               @db.Decimal(20, 4)
  reorderLevel    Decimal                @default(0) @db.Decimal(20, 3)
  minimumStock    Decimal                @default(0) @db.Decimal(20, 3)
  maximumStock    Decimal?               @db.Decimal(20, 3)
  trackingMode    TrackingMode           @default(NONE)
  isActive        Boolean                @default(true)
  archivedAt      DateTime?
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit            UnitOfMeasure          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  balances        InventoryBalance[]
  movements       InventoryMovement[]
  batches         StockBatch[]
  purchaseItems   PurchaseOrderItem[]
  receiptItems    GoodsReceiptItem[]
  salesItems      SalesOrderItem[]
  reservations    InventoryReservation[]
  transferItems   StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  returnItems     InventoryReturnItem[]
  stockCountItems StockCountItem[]
  serialNumbers   StockSerial[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, isActive, name])
  @@index([organizationId, categoryId])
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  code           String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  country        String          @default("Rwanda")
  taxId          String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      PurchaseOrder[]
  receipts       GoodsReceipt[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  code           String
  name           String
  email          String?
  phone          String?
  address        String?
  country        String       @default("Rwanda")
  taxId          String?
  notes          String?
  isActive       Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales          SalesOrder[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model InventoryBalance {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  productId      String            @db.Uuid
  warehouseId    String            @db.Uuid
  locationId     String            @db.Uuid
  onHand         Decimal           @default(0) @db.Decimal(20, 3)
  reserved       Decimal           @default(0) @db.Decimal(20, 3)
  averageCost    Decimal           @default(0) @db.Decimal(20, 4)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location       WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, productId, warehouseId, locationId])
  @@index([organizationId, warehouseId, productId])
}

model InventoryMovement {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  productId      String              @db.Uuid
  warehouseId    String              @db.Uuid
  locationId     String              @db.Uuid
  type           MovementType
  quantityDelta  Decimal             @db.Decimal(20, 3)
  quantityBefore Decimal             @db.Decimal(20, 3)
  quantityAfter  Decimal             @db.Decimal(20, 3)
  unitCost       Decimal             @db.Decimal(20, 4)
  sourceType     String?
  sourceId       String?             @db.Uuid
  idempotencyKey String?
  requestHash    String?
  reason         String?
  actorId        String              @db.Uuid
  reversalOfId   String?             @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location       WarehouseLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reversalOf     InventoryMovement?  @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      InventoryMovement[] @relation("MovementReversal")
  createdAt      DateTime            @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productId, warehouseId, createdAt])
  @@index([organizationId, sourceType, sourceId])
}

model StockBatch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  productId      String       @db.Uuid
  batchNumber    String
  expiryDate     DateTime?
  status         StockStatus  @default(AVAILABLE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, productId, batchNumber])
  @@index([organizationId, expiryDate, status])
}

model PurchaseOrder {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  supplierId        String              @db.Uuid
  warehouseId       String              @db.Uuid
  number            String
  status            PurchaseStatus      @default(DRAFT)
  procurementType   ProcurementType     @default(LOCAL)
  currency          String              @default("RWF") @db.Char(3)
  exchangeRate      Decimal             @default(1) @db.Decimal(20, 8)
  subtotal          Decimal             @default(0) @db.Decimal(20, 4)
  total             Decimal             @default(0) @db.Decimal(20, 4)
  freightCost       Decimal             @default(0) @db.Decimal(20, 4)
  customsCost       Decimal             @default(0) @db.Decimal(20, 4)
  insuranceCost     Decimal             @default(0) @db.Decimal(20, 4)
  otherLandedCost   Decimal             @default(0) @db.Decimal(20, 4)
  originCountry     String?
  shipmentReference String?
  incoterm          String?
  expectedAt        DateTime?
  submittedAt       DateTime?
  approvedAt        DateTime?
  createdById       String              @db.Uuid
  approvedById      String?             @db.Uuid
  notes             String?
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items             PurchaseOrderItem[]
  receipts          GoodsReceipt[]
  returns           InventoryReturn[]   @relation("PurchaseReturns")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, procurementType, status, createdAt])
}

model PurchaseOrderItem {
  id               String             @id @default(uuid()) @db.Uuid
  purchaseOrderId  String             @db.Uuid
  productId        String             @db.Uuid
  quantityOrdered  Decimal            @db.Decimal(20, 3)
  quantityReceived Decimal            @default(0) @db.Decimal(20, 3)
  unitCost         Decimal            @db.Decimal(20, 4)
  lineTotal        Decimal            @db.Decimal(20, 4)
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems     GoodsReceiptItem[]
  serialNumbers    StockSerial[]      @relation("SerialPurchaseOrderItem")

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  purchaseOrderId String?            @db.Uuid
  supplierId      String             @db.Uuid
  warehouseId     String             @db.Uuid
  number          String
  status          DocumentStatus     @default(DRAFT)
  invoiceNumber   String?
  deliveryNote    String?
  postedAt        DateTime?
  postedById      String?            @db.Uuid
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier        Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
}

model GoodsReceiptItem {
  id                  String             @id @default(uuid()) @db.Uuid
  goodsReceiptId      String             @db.Uuid
  purchaseOrderItemId String?            @db.Uuid
  productId           String             @db.Uuid
  locationId          String?            @db.Uuid
  quantity            Decimal            @db.Decimal(20, 3)
  unitCost            Decimal            @db.Decimal(20, 4)
  batchNumber         String?
  expiryDate          DateTime?
  serialNumbers       String[]           @default([])
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
}

model StockSerial {
  id                        String                @id @default(uuid()) @db.Uuid
  organizationId            String                @db.Uuid
  productId                 String                @db.Uuid
  serialNumber              String
  status                    SerialStatus          @default(AVAILABLE)
  warehouseId               String?               @db.Uuid
  locationId                String?               @db.Uuid
  sourcePurchaseOrderItemId String?               @db.Uuid
  issuedSalesOrderItemId    String?               @db.Uuid
  organization              Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product                   Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse                 Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location                  WarehouseLocation?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sourcePurchaseOrderItem   PurchaseOrderItem?    @relation("SerialPurchaseOrderItem", fields: [sourcePurchaseOrderItemId], references: [id], onDelete: Restrict)
  issuedSalesOrderItem      SalesOrderItem?       @relation("SerialSalesOrderItem", fields: [issuedSalesOrderItemId], references: [id], onDelete: Restrict)
  reservation               InventoryReservation?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@unique([organizationId, productId, serialNumber])
  @@index([organizationId, warehouseId, productId, status, locationId])
  @@index([sourcePurchaseOrderItemId])
  @@index([issuedSalesOrderItemId])
}

model SalesOrder {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  customerId          String?                @db.Uuid
  warehouseId         String                 @db.Uuid
  number              String
  status              SalesStatus            @default(DRAFT)
  currency            String                 @default("RWF") @db.Char(3)
  subtotal            Decimal                @default(0) @db.Decimal(20, 4)
  total               Decimal                @default(0) @db.Decimal(20, 4)
  deliveryAddress     String?
  estimatedDeliveryAt DateTime?
  createdById         String                 @db.Uuid
  confirmedAt         DateTime?
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse           Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items               SalesOrderItem[]
  reservations        InventoryReservation[]
  deliveries          SalesDelivery[]
  returns             InventoryReturn[]      @relation("SalesReturns")
  payments            SalesPayment[]
  paymentStatus       SalesPaymentStatus     @default(UNPAID)
  discountPercent     Decimal                @default(0) @db.Decimal(7, 4)
  discountAmount      Decimal                @default(0) @db.Decimal(20, 4)
  taxRate             Decimal                @default(0) @db.Decimal(7, 4)
  taxAmount           Decimal                @default(0) @db.Decimal(20, 4)
  paidAmount          Decimal                @default(0) @db.Decimal(20, 4)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, estimatedDeliveryAt])
}

model SalesOrderItem {
  id             String              @id @default(uuid()) @db.Uuid
  salesOrderId   String              @db.Uuid
  productId      String              @db.Uuid
  quantity       Decimal             @db.Decimal(20, 3)
  quantityIssued Decimal             @default(0) @db.Decimal(20, 3)
  unitPrice      Decimal             @db.Decimal(20, 4)
  lineTotal      Decimal             @db.Decimal(20, 4)
  salesOrder     SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  serialNumbers  StockSerial[]       @relation("SerialSalesOrderItem")
  deliveryItems  SalesDeliveryItem[]

  @@index([salesOrderId])
}

model SalesPayment {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  salesOrderId    String       @db.Uuid
  amount          Decimal      @db.Decimal(20, 4)
  method          String
  reference       String?
  idempotencyKey  String
  requestHash     String
  receivedById    String       @db.Uuid
  receivedAt      DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  receivedBy      User         @relation(fields: [receivedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, salesOrderId, receivedAt])
}

model SalesDelivery {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @db.Uuid
  salesOrderId        String              @db.Uuid
  number              String
  status              DeliveryStatus      @default(IN_TRANSIT)
  deliveryAddress     String?
  carrier             String?
  driverName          String?
  driverPhone         String?
  trackingReference   String?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  proofOfDelivery     String?
  createdById         String              @db.Uuid
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrder          SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items               SalesDeliveryItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  warehouse           Warehouse?          @relation(fields: [warehouseId], references: [id])
  warehouseId         String?             @db.Uuid

  @@unique([organizationId, number])
  @@index([organizationId, status, estimatedDeliveryAt])
  @@index([salesOrderId, createdAt])
}

model SalesDeliveryItem {
  id               String         @id @default(uuid()) @db.Uuid
  deliveryId       String         @db.Uuid
  salesOrderItemId String         @db.Uuid
  quantity         Decimal        @db.Decimal(20, 3)
  serialNumbers    String[]       @default([])
  delivery         SalesDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, salesOrderItemId])
  @@index([deliveryId])
}

model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  salesOrderId   String            @db.Uuid
  productId      String            @db.Uuid
  warehouseId    String            @db.Uuid
  locationId     String            @db.Uuid
  serialNumberId String?           @unique @db.Uuid
  quantity       Decimal           @db.Decimal(20, 3)
  status         ReservationStatus @default(ACTIVE)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrder     SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location       WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  serialNumber   StockSerial?      @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([organizationId, productId, warehouseId, status])
  @@index([organizationId, warehouseId, productId, locationId, status])
  @@index([salesOrderId, status])
}

model StockTransfer {
  id                     String              @id @default(uuid()) @db.Uuid
  organizationId         String              @db.Uuid
  number                 String
  sourceWarehouseId      String              @db.Uuid
  destinationWarehouseId String              @db.Uuid
  status                 TransferStatus      @default(DRAFT)
  dispatchedAt           DateTime?
  receivedAt             DateTime?
  createdById            String              @db.Uuid
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceWarehouse        Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  items                  StockTransferItem[]
  createdAt              DateTime            @default(now())

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
}

model StockTransferItem {
  id               String        @id @default(uuid()) @db.Uuid
  transferId       String        @db.Uuid
  productId        String        @db.Uuid
  quantity         Decimal       @db.Decimal(20, 3)
  quantityReceived Decimal       @default(0) @db.Decimal(20, 3)
  serialNumbers    String[]      @default([])
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
}

model StockAdjustment {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  warehouseId    String                @db.Uuid
  number         String
  status         DocumentStatus        @default(DRAFT)
  reason         String
  requestedById  String                @db.Uuid
  approvedById   String?               @db.Uuid
  postedAt       DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items          StockAdjustmentItem[]
  createdAt      DateTime              @default(now())

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
}

model StockAdjustmentItem {
  id            String          @id @default(uuid()) @db.Uuid
  adjustmentId  String          @db.Uuid
  productId     String          @db.Uuid
  locationId    String?         @db.Uuid
  delta         Decimal         @db.Decimal(20, 3)
  unitCost      Decimal         @db.Decimal(20, 4)
  serialNumbers String[]        @default([])
  adjustment    StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
}

model StockCount {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  warehouseId    String           @db.Uuid
  number         String
  status         StockCountStatus @default(DRAFT)
  reason         String?
  reviewReason   String?
  createdById    String           @db.Uuid
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?          @db.Uuid
  postedAt       DateTime?
  postedById     String?          @db.Uuid
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items          StockCountItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, warehouseId, status])
}

model StockCountItem {
  id               String            @id @default(uuid()) @db.Uuid
  stockCountId     String            @db.Uuid
  productId        String            @db.Uuid
  locationId       String            @db.Uuid
  systemQuantity   Decimal           @db.Decimal(20, 3)
  countedQuantity  Decimal?          @db.Decimal(20, 3)
  stockCount       StockCount        @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location         WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([stockCountId, productId, locationId])
  @@index([productId, locationId])
}

model InventoryReturn {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  warehouseId     String                @db.Uuid
  type            ReturnType
  number          String
  status          DocumentStatus        @default(DRAFT)
  reason          String
  salesOrderId    String?               @db.Uuid
  purchaseOrderId String?               @db.Uuid
  requestedById   String                @db.Uuid
  approvedById    String?               @db.Uuid
  postedAt        DateTime?
  postedById      String?               @db.Uuid
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder?           @relation("SalesReturns", fields: [salesOrderId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?        @relation("PurchaseReturns", fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items           InventoryReturnItem[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, type, status, createdAt])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, purchaseOrderId])
}

model InventoryReturnItem {
  id            String             @id @default(uuid()) @db.Uuid
  returnId      String             @db.Uuid
  productId     String             @db.Uuid
  locationId    String?            @db.Uuid
  quantity      Decimal            @db.Decimal(20, 3)
  unitCost      Decimal            @db.Decimal(20, 4)
  serialNumbers String[]           @default([])
  return        InventoryReturn    @relation(fields: [returnId], references: [id], onDelete: Restrict)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  location      WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([productId])
}

model IdempotencyRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  key            String
  operation      String
  requestHash    String
  response       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?

  @@unique([organizationId, key])
  @@index([expiresAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  action         String
  entityType     String
  entityId       String?
  requestId      String?
  ipAddress      String?
  userAgent      String?
  changes        Json?
  reason         String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorId, createdAt])
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  recipientId    String?      @db.Uuid
  type           String
  dedupeKey      String?
  title          String
  body           String
  data           Json?
  readAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, recipientId, readAt, createdAt])
}
