NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stock:stock@localhost:5432/stock?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
ALLOW_ORG_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8003
LOG_LEVEL=info